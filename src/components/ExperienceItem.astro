---
interface Props {
  title: string;
  company: string;
  date: string;
  description: string;
  tags: string[];
}

const { title, company, date, description, tags } = Astro.props;
---

<div class="glass rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 group">
  <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start mb-6">
    <div class="space-y-2">
      <h3 class="text-xl md:text-2xl font-bold text-white group-hover:text-blue-400 transition-colors">
        {title}
      </h3>
      <p class="text-blue-400 font-semibold text-lg">{company}</p>
    </div>
    <span class="text-gray-400 bg-white/5 px-3 py-1 rounded-full text-sm mt-2 lg:mt-0">
      {date}
    </span>
  </div>

  <p class="text-gray-300 leading-relaxed mb-6">{description}</p>

  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-500/20 text-blue-300 border border-blue-500/30">
        {tag}
      </span>
    ))}
  </div>
</div>
