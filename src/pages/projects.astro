---
import Layout from "../layouts/Layout.astro";
import Github from "../components/icons/Github.astro";
---

<Layout
  title="Proyectos | Luis Alberto - Full Stack Developer"
  description="Selección de proyectos destacados de Luis Alberto Jiménez Soto: sistemas ERP, aplicaciones móviles Flutter, APIs RESTful y más."
>
  <main class="px-4">
    <section class="w-full mx-auto lg:w-[720px] py-16">
      <div class="text-center mb-16">
        <h1 class="text-white text-4xl md:text-5xl font-bold mb-6">
          Mis Proyectos
        </h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">
          Una selección de proyectos que destacan mi experiencia en desarrollo
          Full Stack, desde aplicaciones empresariales hasta soluciones
          innovadoras.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Proyecto 1: Sistema ERP Simon-e -->
        <div
          class="glass rounded-2xl overflow-hidden hover:bg-white/10 transition-all duration-300 group"
        >
          <div
            class="h-48 bg-gradient-to-br from-blue-500/20 to-purple-500/20 flex items-center justify-center"
          >
            <div class="text-6xl">🏢</div>
          </div>
          <div class="p-6">
            <h3 class="text-white text-xl font-bold mb-3">
              Sistema ERP Simon-e
            </h3>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              Desarrollo y mantenimiento de aplicaciones web críticas en C#
              dentro del sistema ERP empresarial. Optimización de APIs y
              migración de aplicaciones legacy.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span
                class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded text-xs"
                >C#</span
              >
              <span
                class="bg-blue-500/20 text-blue-300 px-2 py-1 rounded text-xs"
                >.NET Core</span
              >
              <span
                class="bg-green-500/20 text-green-300 px-2 py-1 rounded text-xs"
                >SQL Server</span
              >
              <span
                class="bg-orange-500/20 text-orange-300 px-2 py-1 rounded text-xs"
                >MVC</span
              >
            </div>
            <div class="text-xs text-gray-400">
              <span class="font-semibold text-blue-400">Empresa:</span> Tenco Integración
              de Sistemas
            </div>
          </div>
        </div>

        <!-- Proyecto 2: Aplicaciones Móviles Flutter -->
        <div
          class="glass rounded-2xl overflow-hidden hover:bg-white/10 transition-all duration-300 group"
        >
          <div
            class="h-48 bg-gradient-to-br from-cyan-500/20 to-blue-500/20 flex items-center justify-center"
          >
            <div class="text-6xl">📱</div>
          </div>
          <div class="p-6">
            <h3 class="text-white text-xl font-bold mb-3">
              Aplicaciones Móviles Flutter
            </h3>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              Desarrollo de aplicaciones móviles completas para migración de
              servicios externos (Concur) a soluciones internas, incluyendo
              viáticos y reservas.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span
                class="bg-cyan-500/20 text-cyan-300 px-2 py-1 rounded text-xs"
                >Flutter</span
              >
              <span
                class="bg-blue-500/20 text-blue-300 px-2 py-1 rounded text-xs"
                >Dart</span
              >
              <span
                class="bg-orange-500/20 text-orange-300 px-2 py-1 rounded text-xs"
                >Firebase</span
              >
              <span class="bg-red-500/20 text-red-300 px-2 py-1 rounded text-xs"
                >Push Notifications</span
              >
            </div>
            <div class="text-xs text-gray-400">
              <span class="font-semibold text-blue-400">Cliente:</span> Empresa corporativa
            </div>
          </div>
        </div>

        <!-- Proyecto 3: APIs RESTful ClubLia -->
        <div
          class="glass rounded-2xl overflow-hidden hover:bg-white/10 transition-all duration-300 group"
        >
          <div
            class="h-48 bg-gradient-to-br from-green-500/20 to-cyan-500/20 flex items-center justify-center"
          >
            <div class="text-6xl">🔌</div>
          </div>
          <div class="p-6">
            <h3 class="text-white text-xl font-bold mb-3">
              APIs RESTful - ClubLia
            </h3>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              Diseño y construcción de APIs de alto rendimiento utilizando .NET
              Core 6. Desarrollo de funcionalidades complejas con Laravel y
              React.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span
                class="bg-blue-500/20 text-blue-300 px-2 py-1 rounded text-xs"
                >.NET Core 6</span
              >
              <span class="bg-red-500/20 text-red-300 px-2 py-1 rounded text-xs"
                >Laravel</span
              >
              <span
                class="bg-cyan-500/20 text-cyan-300 px-2 py-1 rounded text-xs"
                >React</span
              >
              <span
                class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded text-xs"
                >WordPress</span
              >
            </div>
            <div class="text-xs text-gray-400">
              <span class="font-semibold text-blue-400">Cliente:</span> ClubLia
            </div>
          </div>
        </div>

        <!-- Proyecto 4: Bot de Telegram -->
        <div
          class="glass rounded-2xl overflow-hidden hover:bg-white/10 transition-all duration-300 group"
        >
          <div
            class="h-48 bg-gradient-to-br from-yellow-500/20 to-green-500/20 flex items-center justify-center"
          >
            <div class="text-6xl">🤖</div>
          </div>
          <div class="p-6">
            <h3 class="text-white text-xl font-bold mb-3">
              Bot de Automatización
            </h3>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              Desarrollo de Bot de Telegram para automatización de tareas
              específicas, mejorando significativamente la eficiencia operativa
              del equipo.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span
                class="bg-yellow-500/20 text-yellow-300 px-2 py-1 rounded text-xs"
                >Python</span
              >
              <span
                class="bg-blue-500/20 text-blue-300 px-2 py-1 rounded text-xs"
                >Telegram API</span
              >
              <span
                class="bg-green-500/20 text-green-300 px-2 py-1 rounded text-xs"
                >Automation</span
              >
            </div>
            <div class="text-xs text-gray-400">
              <span class="font-semibold text-blue-400">Empresa:</span> Centro de
              Innovación Tecnológica (ITD)
            </div>
          </div>
        </div>

        <!-- Proyecto 5: Migración de Base de Datos -->
        <div
          class="glass rounded-2xl overflow-hidden hover:bg-white/10 transition-all duration-300 group"
        >
          <div
            class="h-48 bg-gradient-to-br from-purple-500/20 to-pink-500/20 flex items-center justify-center"
          >
            <div class="text-6xl">🗄️</div>
          </div>
          <div class="p-6">
            <h3 class="text-white text-xl font-bold mb-3">
              Migración de Datos Masiva
            </h3>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              Limpieza y transformación de datos (DBF, XLS, CSV) con Python para
              migración exitosa a SQL Server, mejorando calidad y accesibilidad.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span
                class="bg-yellow-500/20 text-yellow-300 px-2 py-1 rounded text-xs"
                >Python</span
              >
              <span
                class="bg-blue-500/20 text-blue-300 px-2 py-1 rounded text-xs"
                >SQL Server</span
              >
              <span
                class="bg-green-500/20 text-green-300 px-2 py-1 rounded text-xs"
                >Data Processing</span
              >
              <span
                class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded text-xs"
                >ETL</span
              >
            </div>
            <div class="text-xs text-gray-400">
              <span class="font-semibold text-blue-400">Empresa:</span> SC Computación
            </div>
          </div>
        </div>

        <!-- Proyecto 6: Sistema de Facturación CFDI -->
        <div
          class="glass rounded-2xl overflow-hidden hover:bg-white/10 transition-all duration-300 group"
        >
          <div
            class="h-48 bg-gradient-to-br from-red-500/20 to-orange-500/20 flex items-center justify-center"
          >
            <div class="text-6xl">🧾</div>
          </div>
          <div class="p-6">
            <h3 class="text-white text-xl font-bold mb-3">
              Sistema de Facturación CFDI
            </h3>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              Actualización del sistema de facturación de CFDI 3.3 a CFDI 4.0,
              asegurando cumplimiento normativo y continuidad operativa.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-red-500/20 text-red-300 px-2 py-1 rounded text-xs"
                >Flask</span
              >
              <span
                class="bg-cyan-500/20 text-cyan-300 px-2 py-1 rounded text-xs"
                >React</span
              >
              <span
                class="bg-yellow-500/20 text-yellow-300 px-2 py-1 rounded text-xs"
                >Python</span
              >
              <span
                class="bg-green-500/20 text-green-300 px-2 py-1 rounded text-xs"
                >CFDI 4.0</span
              >
            </div>
            <div class="text-xs text-gray-400">
              <span class="font-semibold text-blue-400">Empresa:</span> Centro de
              Innovación Tecnológica (ITD)
            </div>
          </div>
        </div>
      </div>

      <!-- GitHub CTA -->
      <div
        class="glass rounded-2xl p-8 bg-gradient-to-r from-purple-500/10 to-blue-500/10 text-center mt-12"
      >
        <h3 class="text-white text-2xl font-bold mb-4">¿Quieres ver más?</h3>
        <p class="text-gray-300 mb-6 max-w-2xl mx-auto">
          Estos son solo algunos de los proyectos en los que he trabajado.
          Puedes encontrar más código y contribuciones en mi perfil de GitHub.
        </p>
        <a
          href="https://github.com/Lajs5257"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-white/10 hover:bg-white/20 text-white px-6 py-3 rounded-lg transition-all duration-300 group"
        >
          <Github class="w-5 h-5 group-hover:scale-110 transition-transform" />
          Ver GitHub
        </a>
      </div>
    </section>
  </main>
</Layout>
